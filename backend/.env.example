# MySQL Database Connection URL
DATABASE_URL="mysql://username:password@localhost:3306/opendrive"

# Backend Server Port
APP_PORT=4000

# Frontend Web Application URL (used for CORS and redirect origins)
FRONTEND_URL="http://localhost:5173"

# JWT Secret for access tokens (minimum 32 characters random string)
JWT_ACCESS_SECRET="generate-a-secure-random-string-at-least-32-chars-long"

# AES-256-GCM Token Encryption Key for connected accounts (minimum 32 characters)
TOKEN_ENCRYPTION_KEY="generate-a-secure-random-key-at-least-32-chars-long"

# Token Lifespans
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# Maximum Upload File Size in Bytes (default: 5GB = 5368709120)
MAX_UPLOAD_BYTES=5368709120

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/connected-accounts/google/callback"

# Optional: Google reCAPTCHA v2/v3 Secret Key (leave empty to disable captcha)
RECAPTCHA_SECRET_KEY=""
